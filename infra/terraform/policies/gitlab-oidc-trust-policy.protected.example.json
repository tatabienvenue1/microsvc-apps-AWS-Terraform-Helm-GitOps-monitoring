{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitLabOidcAssumeRoleProtectedBranch",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::<AWS_ACCOUNT_ID>:oidc-provider/gitlab.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "gitlab.com:aud": "https://gitlab.com",
          "gitlab.com:ref_protected": "true"
        },
        "StringLike": {
          "gitlab.com:sub": "project_path:<GROUP>/<PROJECT>:ref_type:branch:ref:main"
        }
      }
    }
  ]
}
