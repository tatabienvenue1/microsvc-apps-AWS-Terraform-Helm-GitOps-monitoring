aws_region            = "eu-west-1"
project_name          = "online-boutique"
eks_cluster_version   = "1.31"
eks_node_desired_size = 2
eks_node_instance_types = ["t3.large"]
# Security: restrict public EKS API endpoint access to trusted CIDRs.
# Example: home/office public IP with /32.
eks_cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]
# Optional: disable public endpoint completely after initial bootstrap.
# eks_cluster_endpoint_public_access = false

# Optional Phase 1 TLS: set both to create an ACM cert + Route 53 DNS validation in this account.
# app_certificate_domain_name = "boutique.example.com"
# route53_hosted_zone_id      = "Z0XXXXXXXXXXXXXXXXXXX"

tags = {
  Owner = "your-name"
}
